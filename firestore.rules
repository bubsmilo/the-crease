rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }
    function role(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role;
    }
    function isOwner(teamId) { return isMember(teamId) && role(teamId) == 'owner'; }
    function canEdit(teamId) {
      return isMember(teamId) && role(teamId) in ['owner', 'editor', 'statistician'];
    }
    function canManageRoster(teamId) {
      return isMember(teamId) && role(teamId) in ['owner', 'editor'];
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(teamId);

      match /members/{uid} {
        allow read: if isMember(teamId);
        allow create: if signedIn() && (
          (uid == request.auth.uid &&
           exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)) &&
           get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.teamId == teamId &&
           get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.status == 'pending')
          || isOwner(teamId)
        );
        allow update, delete: if isOwner(teamId) || (signedIn() && uid == request.auth.uid);
      }

      match /goalies/{docId} {
        allow read: if isMember(teamId);
        allow create, update, delete: if canManageRoster(teamId);
      }

      match /games/{docId} {
        allow read: if isMember(teamId);
        allow create, update, delete: if canEdit(teamId);
      }
    }

    match /invites/{code} {
      // A signed-in user must be able to look up a code before they are a team member.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && isOwner(request.resource.data.teamId);
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.status == 'pending'
         && request.resource.data.status == 'accepted'
         && request.resource.data.acceptedBy == request.auth.uid
         && request.resource.data.teamId == resource.data.teamId
         && request.resource.data.role == resource.data.role)
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
