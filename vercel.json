const CACHE="crease-v800-brand-system";
const ASSETS=["./","./index.html","./manifest-v800.webmanifest","./assets/branding/icon-192.png","./assets/branding/icon-512.png","./assets/branding/icon-maskable-512.png","./assets/branding/icon-1024.png","./assets/branding/logo-rounded.png","./assets/branding/splash-logo.png","./assets/branding/favicon.png"];
self.addEventListener("install",e=>{e.waitUntil(caches.open(CACHE).then(c=>c.addAll(ASSETS)).catch(()=>{}));self.skipWaiting()});
self.addEventListener("activate",e=>{e.waitUntil(caches.keys().then(keys=>Promise.all(keys.filter(k=>k!==CACHE).map(k=>caches.delete(k)))));self.clients.claim()});
self.addEventListener("fetch",e=>{const u=new URL(e.request.url);const branded=/manifest-v800|assets\/branding/.test(u.pathname);if(branded){e.respondWith(fetch(e.request,{cache:"reload"}));return}if(e.request.mode==="navigate"){e.respondWith(fetch(e.request).then(r=>{const copy=r.clone();caches.open(CACHE).then(c=>c.put("./index.html",copy));return r}).catch(()=>caches.match("./index.html")));return}e.respondWith(caches.match(e.request).then(c=>c||fetch(e.request).then(r=>{if(e.request.method==="GET"){const copy=r.clone();caches.open(CACHE).then(cache=>cache.put(e.request,copy))}return r})))});
